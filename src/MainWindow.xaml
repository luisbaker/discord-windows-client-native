<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DiscordWin3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DiscordWin3"
    Title="Discord Win3">

    <Grid Background="{StaticResource RailBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource RailBrush}">
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" Text="Discord Win3" />
            <TextBlock x:Name="StatusText" Margin="0,0,150,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        </Grid>

        <!-- ======================= Chat ======================= -->
        <Grid x:Name="ChatRoot" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Guild rail -->
            <ListView x:Name="GuildList" Grid.Column="0" Background="{StaticResource RailBrush}"
                      SelectionMode="Single" SelectionChanged="OnGuildSelected" Padding="0,4,0,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,4,0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="MinHeight" Value="48" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:GuildItem">
                        <Grid Width="48" Height="48" ToolTipService.ToolTip="{x:Bind Name}">
                            <Border CornerRadius="16" Background="{StaticResource ChatBrush}">
                                <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind InitialsVisibility}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="14" Foreground="{StaticResource HeaderTextBrush}" />
                            </Border>
                            <Border CornerRadius="16" Visibility="{x:Bind IconVisibility}">
                                <Image Source="{x:Bind Icon}" Width="48" Height="48" Stretch="UniformToFill" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Channel sidebar -->
            <Grid Grid.Column="1" Background="{StaticResource SidebarBrush}" CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource RailBrush}" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="GuildTitle" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource HeaderTextBrush}" />
                </Border>
                <ListView x:Name="ChannelList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="OnChannelSelected" Padding="8,8,8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="MinHeight" Value="32" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ChannelItem">
                            <Grid>
                                <TextBlock Visibility="{x:Bind CategoryVisibility}" Text="{x:Bind Name}"
                                           Margin="0,12,0,0" FontSize="11" FontWeight="SemiBold"
                                           CharacterSpacing="40" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel Visibility="{x:Bind ChannelVisibility}" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Glyph}" Width="16" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource BodyTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" Background="#232428" Padding="12,0,8,0">
                    <TextBlock x:Name="SelfName" VerticalAlignment="Center" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,40,0"
                               Foreground="{StaticResource HeaderTextBrush}" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnLogout"
                            ToolTipService.ToolTip="Se déconnecter" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xF3B1;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>

            <!-- Chat area -->
            <Grid Grid.Column="2" Background="{StaticResource ChatBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource RailBrush}" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="ChannelTitle" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource HeaderTextBrush}" />
                </Border>

                <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False"
                          Loaded="OnMessageListLoaded">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MessageItem">
                            <Grid Padding="{x:Bind RowPadding}" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                        Visibility="{x:Bind HeaderVisibility}" Background="{StaticResource ComposerBrush}">
                                    <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind HeaderVisibility}">
                                        <TextBlock Text="{x:Bind AuthorName}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource HeaderTextBrush}" />
                                        <TextBlock Text="{x:Bind Timestamp}" FontSize="12" VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Content}" Visibility="{x:Bind ContentVisibility}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{StaticResource BodyTextBrush}" />
                                    <Border Visibility="{x:Bind ImageVisibility}" CornerRadius="8" HorizontalAlignment="Left"
                                            Width="{x:Bind ImageWidth}" Height="{x:Bind ImageHeight}" Margin="0,4,0,0"
                                            Background="{StaticResource SidebarBrush}">
                                        <Image Source="{x:Bind Image}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Files}" Visibility="{x:Bind FilesVisibility}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"
                                               Foreground="#00A8FC" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="2" Margin="16,0,16,20" CornerRadius="8" Background="{StaticResource ComposerBrush}">
                    <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200"
                             BorderThickness="0" Background="Transparent" Padding="16,11"
                             PreviewKeyDown="OnComposerKeyDown" IsEnabled="False" />
                </Border>
            </Grid>
        </Grid>

        <!-- ======================= Login ======================= -->
        <Grid x:Name="LoginRoot" Grid.Row="1" Background="{StaticResource BlurpleBrush}">
            <Border Width="720" MinHeight="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="8" Padding="32" Background="{StaticResource ChatBrush}">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Ha, te revoilà !" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource HeaderTextBrush}" />
                        <TextBlock Text="Client natif WinUI 3 — sans Electron." HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="TOKEN (option avancée)" Margin="0,16,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <PasswordBox x:Name="TokenBox" PlaceholderText="Colle ton token ici" />
                        <Button x:Name="TokenLoginButton" Content="Connexion" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" Click="OnTokenLogin" />
                        <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="#F23F42" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                        <Border Width="176" Height="176" CornerRadius="8" Background="White" Padding="8"
                                HorizontalAlignment="Center">
                            <Grid>
                                <ProgressRing x:Name="QrProgress" IsActive="True" Width="32" Height="32" />
                                <Image x:Name="QrImage" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="QrTitle" Text="Se connecter avec un code QR" FontSize="18" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource HeaderTextBrush}" />
                        <TextBlock x:Name="QrHint" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Scanne ce code avec l'application mobile Discord pour te connecter instantanément." />
                        <HyperlinkButton x:Name="QrRetry" Content="Générer un nouveau code" HorizontalAlignment="Center"
                                         Visibility="Collapsed" Click="OnQrRetry" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
