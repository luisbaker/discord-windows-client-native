<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DiscordWin3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DiscordWin3"
    Title="Discord Win3">

    <Grid Background="{StaticResource RailBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: current server / conversation, centered like the official client -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource RailBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Border Width="16" Height="16" CornerRadius="4">
                    <Image x:Name="TitleIcon" Stretch="UniformToFill" />
                </Border>
                <TextBlock x:Name="TitleText" Text="Discord Win3" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource HeaderTextBrush}" />
            </StackPanel>
            <StackPanel x:Name="NavButtons" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,0" Spacing="2">
                <Button x:Name="BackButton" Click="OnNavigateBack" IsEnabled="False" Padding="8,4" Background="Transparent"
                        BorderThickness="0" ToolTipService.ToolTip="Précédent (Alt+←)">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                </Button>
                <Button x:Name="ForwardButton" Click="OnNavigateForward" IsEnabled="False" Padding="8,4" Background="Transparent"
                        BorderThickness="0" ToolTipService.ToolTip="Suivant (Alt+→)">
                    <FontIcon Glyph="&#xE72A;" FontSize="12" />
                </Button>
                <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <!-- ======================= Chat ======================= -->
        <Grid x:Name="ChatRoot" Grid.Row="1" Visibility="Collapsed" Opacity="0">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Grid.OpacityTransition>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Server rail -->
            <ListView x:Name="GuildList" Grid.Column="0" Background="{StaticResource RailBrush}"
                      SelectionMode="Single" SelectionChanged="OnGuildSelected" Padding="0,4,0,4"
                      ContainerContentChanging="OnGuildContainerChanging">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,4,0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:GuildItem">
                        <!-- Rounded clip is applied and animated in code (circle <-> squircle). -->
                        <Grid Width="72" Height="48">
                            <!-- Unread pill on the rail edge -->
                            <Rectangle Visibility="{x:Bind UnreadVisibility}" Width="4" Height="8" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Left" Margin="-2,0,0,0" Fill="{StaticResource HeaderTextBrush}" />
                            <Grid x:Name="IconHost" Width="48" Height="48" ToolTipService.ToolTip="{x:Bind Name}"
                                  Background="{StaticResource ComposerBrush}">
                                <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind InitialsVisibility}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="15" Foreground="{StaticResource HeaderTextBrush}" />
                                <Image Source="{x:Bind Icon}" Visibility="{x:Bind IconVisibility}"
                                       Width="48" Height="48" Stretch="UniformToFill" />
                            </Grid>
                            <!-- Mention badge -->
                            <Border Visibility="{x:Bind MentionVisibility}" MinWidth="18" Height="18" CornerRadius="9"
                                    Padding="4,0" Background="#F23F43" BorderBrush="{StaticResource RailBrush}" BorderThickness="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,-2">
                                <TextBlock Text="{x:Bind MentionText}" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Channel sidebar -->
            <Grid Grid.Column="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1,1,1,0" CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel x:Name="GuildHeader" Orientation="Horizontal" Margin="16,0" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="GuildTitle" FontWeight="SemiBold" FontSize="15" MaxWidth="230"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource HeaderTextBrush}" />
                            <FontIcon Glyph="&#xE70D;" FontSize="11" Foreground="{StaticResource HeaderTextBrush}" />
                        </StackPanel>
                        <!-- Home: quick switcher entry, like the official client -->
                        <Button x:Name="QuickSwitchButton" Visibility="Collapsed" Click="OnQuickSwitch" Margin="10,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="30" Padding="8,0"
                                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" CornerRadius="8"
                                ToolTipService.ToolTip="Ctrl+K">
                            <TextBlock x:Name="QuickSwitchText" Text="Recherche ou lance une conversation" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BodyTextBrush}" />
                        </Button>
                    </Grid>
                </Border>
                <!-- Home: "Amis" entry + "Messages privés" header -->
                <StackPanel x:Name="HomeNav" Grid.Row="1" Visibility="Collapsed" Padding="8,8,8,0" Spacing="4">
                    <Button x:Name="FriendsNavButton" Click="OnShowFriends" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6" BorderThickness="0"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE716;" FontSize="18" />
                            <TextBlock x:Name="FriendsNavText" Text="Amis" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="8,4" />
                    <TextBlock x:Name="DmHeaderText" Text="Messages privés" Margin="8,4,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <ListView x:Name="ChannelList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="OnChannelClicked" SelectionChanged="OnChannelSelected" Padding="8,8,8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ChannelItem">
                            <Grid Margin="{x:Bind ItemMargin}">
                                <StackPanel Visibility="{x:Bind CategoryVisibility}" Orientation="Horizontal" Spacing="4"
                                            Margin="0,14,0,0">
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{x:Bind Glyph}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Visibility="{x:Bind ChannelVisibility}" Orientation="Horizontal" Spacing="8"
                                            Opacity="{x:Bind TextOpacity}">
                                    <TextBlock Text="{x:Bind Glyph}" Width="18" FontSize="16" Visibility="{x:Bind GlyphVisibility}"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                    <Grid Visibility="{x:Bind AvatarVisibility}" Width="{x:Bind AvatarSize}" Height="{x:Bind AvatarSize}"
                                          VerticalAlignment="Center">
                                        <Border CornerRadius="16" Background="{StaticResource ComposerBrush}" BorderBrush="{x:Bind AvatarRing}" BorderThickness="2">
                                            <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                        </Border>
                                        <Ellipse Visibility="{x:Bind StatusVisibility}" Width="12" Height="12" Margin="0,0,-2,-2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Fill="{x:Bind StatusBrush}" Stroke="{StaticResource SidebarBrush}" StrokeThickness="2" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                                   Foreground="{x:Bind NameBrush}" FontWeight="{x:Bind NameWeight}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Visibility="{x:Bind SubtitleVisibility}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="190" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Visibility="{x:Bind MentionVisibility}" MinWidth="16" Height="16" CornerRadius="8"
                                        Padding="4,0" Background="#F23F43" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind MentionText}" FontSize="11" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Voice panel + user panel (span rail + sidebar, floating card like the 2025 client) -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="8" CornerRadius="8"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid x:Name="VoicePanel" Visibility="Collapsed" Padding="12,8,8,8" ColumnSpacing="8"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Tapped="OnOpenCallView" Background="Transparent">
                    <TextBlock x:Name="VoiceStatusText" FontSize="14" FontWeight="SemiBold" Foreground="#23A55A"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="VoiceChannelText" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button x:Name="VoiceDisconnectButton" Grid.Column="1" Click="OnVoiceDisconnect" Width="36" Height="32"
                        Padding="0" CornerRadius="6" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE778;" FontSize="16" />
                </Button>
            </Grid>
            <Grid Padding="8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36">
                    <Border CornerRadius="18" Background="{StaticResource ComposerBrush}">
                        <Image x:Name="SelfAvatar" Stretch="UniformToFill" />
                    </Border>
                    <Ellipse x:Name="SelfStatus" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#23A55A" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SelfName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource HeaderTextBrush}" />
                    <TextBlock x:Name="SelfStatusText" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button x:Name="MuteButton" Grid.Column="2" VerticalAlignment="Center" Click="OnToggleMute"
                        Width="32" Height="32" Padding="0" CornerRadius="6" Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="16" />
                </Button>
                <Button x:Name="DeafenButton" Grid.Column="3" VerticalAlignment="Center" Click="OnToggleDeafen"
                        Width="32" Height="32" Padding="0" CornerRadius="6" Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="DeafenIcon" Glyph="&#xE7F6;" FontSize="16" />
                </Button>
                <Button x:Name="SettingsButton" Grid.Column="4" VerticalAlignment="Center" Click="OnSettings"
                        Width="32" Height="32" Padding="0" CornerRadius="6"
                        ToolTipService.ToolTip="Paramètres" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>
            </StackPanel>

            <!-- Chat area -->
            <Grid x:Name="ChatArea" Grid.Column="2" Grid.RowSpan="2" Background="{StaticResource ChatBrush}"
                  AllowDrop="True" DragOver="OnChatDragOver" Drop="OnChatDrop"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="ChannelGlyph" FontSize="20" Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="ChannelAvatarBorder" Width="24" Height="24" CornerRadius="12" Visibility="Collapsed"
                                Background="{StaticResource ComposerBrush}">
                            <Image x:Name="ChannelAvatar" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock x:Name="ChannelTitle" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{StaticResource HeaderTextBrush}" />
                    </StackPanel>
                    <Button x:Name="CallButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,48,0" Click="OnStartCall" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE717;" FontSize="18" />
                    </Button>
                    <ToggleButton x:Name="MembersToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="True" Click="OnToggleMembers" Background="Transparent" BorderThickness="0"
                                  ToolTipService.ToolTip="Afficher la liste des membres">
                        <FontIcon Glyph="&#xE716;" FontSize="18" />
                    </ToggleButton>
                </Grid>

                <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False"
                          Loaded="OnMessageListLoaded" ContainerContentChanging="OnMessageContainerChanging">
                    <ListView.OpacityTransition><ScalarTransition Duration="0:0:0.18" /></ListView.OpacityTransition>
                    <ListView.TranslationTransition><Vector3Transition Duration="0:0:0.22" /></ListView.TranslationTransition>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MessageItem">
                            <StackPanel>
                                <!-- Day separator -->
                                <Grid Visibility="{x:Bind DayVisibility}" Margin="16,20,16,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DayText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource LineBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Padding="{x:Bind RowPadding}" Background="{x:Bind RowBackground}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                            Margin="0,2,0,0" Visibility="{x:Bind HeaderVisibility}"
                                            Background="{StaticResource ComposerBrush}">
                                        <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind ReplyText}" Visibility="{x:Bind ReplyVisibility}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HeaderVisibility}">
                                            <TextBlock Text="{x:Bind AuthorName}" FontWeight="SemiBold" FontSize="15"
                                                       Foreground="{x:Bind AuthorBrush}" />
                                            <Border Visibility="{x:Bind TagVisibility}" CornerRadius="4" Padding="5,0"
                                                    Background="#2E2F35" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TagText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource HeaderTextBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Timestamp}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <!-- Filled in code: mentions as pills, links, custom emojis, markdown-lite -->
                                        <RichTextBlock x:Name="Body" Visibility="{x:Bind ContentVisibility}" FontSize="15"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Foreground="{StaticResource BodyTextBrush}" />
                                        <!-- Image or video poster; the video player is only created on ▶ (RAM) -->
                                        <Grid x:Name="MediaHost" Visibility="{x:Bind ImageVisibility}" CornerRadius="8" HorizontalAlignment="Left"
                                              Width="{x:Bind ImageWidth}" Height="{x:Bind ImageHeight}" Margin="0,4,0,0"
                                              Background="{StaticResource CardBrush}">
                                            <Image Source="{x:Bind Image}" Stretch="Uniform" />
                                            <Button Visibility="{x:Bind VideoVisibility}" Click="OnPlayVideo" Width="56" Height="56"
                                                    CornerRadius="28" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="#B3000000" BorderThickness="0">
                                                <FontIcon Glyph="&#xF5B0;" FontSize="22" Foreground="White" />
                                            </Button>
                                            <Button x:Name="DownloadButton" Click="OnDownloadMedia" Width="32" Height="32" Padding="0"
                                                    CornerRadius="6" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#B3000000" BorderThickness="0">
                                                <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="White" />
                                            </Button>
                                        </Grid>
                                        <!-- Link preview card -->
                                        <Grid Visibility="{x:Bind EmbedVisibility}" HorizontalAlignment="Left" MaxWidth="520"
                                              Margin="0,4,0,0" CornerRadius="4" Background="{StaticResource CardBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{x:Bind EmbedBar}" />
                                            <StackPanel Grid.Column="1" Padding="12,8,16,12" Spacing="4">
                                                <TextBlock Text="{x:Bind EmbedProvider}" Visibility="{x:Bind EmbedProviderVisibility}"
                                                           FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{x:Bind EmbedTitle}" Visibility="{x:Bind EmbedTitleVisibility}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource LinkBrush}" />
                                                <TextBlock Text="{x:Bind EmbedDescription}" Visibility="{x:Bind EmbedDescriptionVisibility}"
                                                           FontSize="14" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource BodyTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Files}" Visibility="{x:Bind FilesVisibility}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="14"
                                                   Foreground="{StaticResource LinkBrush}" />
                                        <!-- Filled in code: one chip per reaction -->
                                        <StackPanel x:Name="Reactions" Visibility="{x:Bind ReactionsVisibility}"
                                                    Orientation="Horizontal" Spacing="4" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <!-- Hover action bar (shown on pointer over), like the official client -->
                                    <Border x:Name="HoverBar" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="0,-6,0,0" Padding="2" CornerRadius="8"
                                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="Quick0" Click="OnHoverReaction" Style="{StaticResource HoverButton}" FontSize="17" />
                                            <Button x:Name="Quick1" Click="OnHoverReaction" Style="{StaticResource HoverButton}" FontSize="17" />
                                            <Button x:Name="Quick2" Click="OnHoverReaction" Style="{StaticResource HoverButton}" FontSize="17" />
                                            <Rectangle Width="1" Height="20" Margin="4,0" Fill="{StaticResource LineBrush}" />
                                            <Button x:Name="HoverPicker" Click="OnHoverPicker" Style="{StaticResource HoverButton}">
                                                <FontIcon Glyph="&#xE76E;" FontSize="16" />
                                            </Button>
                                            <Button x:Name="HoverEdit" Click="OnHoverEdit" Visibility="{x:Bind OwnVisibility}" Style="{StaticResource HoverButton}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="16" />
                                            </Button>
                                            <Button x:Name="HoverReply" Click="OnHoverReply" Visibility="{x:Bind OthersVisibility}" Style="{StaticResource HoverButton}">
                                                <FontIcon Glyph="&#xE97A;" FontSize="16" />
                                            </Button>
                                            <Button x:Name="HoverForward" Click="OnHoverForward" Style="{StaticResource HoverButton}">
                                                <FontIcon Glyph="&#xE72D;" FontSize="16" />
                                            </Button>
                                            <Button x:Name="HoverMore" Click="OnHoverMore" Style="{StaticResource HoverButton}">
                                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Composer -->
                <Grid Grid.Row="2" Margin="16,0,16,0" CornerRadius="8" Background="{StaticResource ComposerBrush}"
                      BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- "Réponse à X" / "Modification" bar -->
                    <Grid x:Name="ReplyBar" Grid.ColumnSpan="3" Visibility="Collapsed" Padding="16,6,8,6"
                          Background="#1D1E22" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="ReplyText" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,40,0" />
                        <Button x:Name="CancelReplyButton" HorizontalAlignment="Right" Click="OnCancelReply" Padding="6,2" Background="Transparent"
                                BorderThickness="0" ToolTipService.ToolTip="Annuler (Échap)">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <!-- Files waiting to be sent (preview cards with edit / remove) -->
                    <ScrollViewer x:Name="PendingScroller" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                                  BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <StackPanel x:Name="PendingPanel" Orientation="Horizontal" Spacing="16" Padding="16,20,16,12" />
                    </ScrollViewer>
                    <Button x:Name="AttachButton" Grid.Row="2" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnAttach" IsEnabled="False"
                            Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Envoyer un fichier">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                    <TextBox x:Name="Composer" Grid.Row="2" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200"
                             BorderThickness="0" Background="Transparent" Padding="8,11,16,11" FontSize="15"
                             PreviewKeyDown="OnComposerKeyDown" TextChanged="OnComposerTextChanged" Paste="OnComposerPaste"
                             IsEnabled="False" />
                    <Button x:Name="ComposerEmojiButton" Grid.Row="2" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"
                            Click="OnComposerEmoji" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Choisir un emoji">
                        <FontIcon Glyph="&#xE76E;" FontSize="18" />
                    </Button>
                </Grid>
                <TextBlock x:Name="TypingText" Grid.Row="3" Margin="18,2,16,0" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource BodyTextBrush}" />

                <!-- ======================= Call screen (voice) ======================= -->
                <Grid x:Name="CallView" Grid.RowSpan="4" Visibility="Collapsed" Background="#0B0B0D">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F50A;" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock x:Name="CallTitle" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{StaticResource HeaderTextBrush}" />
                    </StackPanel>

                    <!-- Participant tiles -->
                    <GridView x:Name="CallGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="6" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ParticipantItem">
                                <Grid Width="300" Height="170" CornerRadius="10" Background="#1E1F22"
                                      BorderBrush="{x:Bind RingBrush}" BorderThickness="3">
                                    <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource ComposerBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                    </Border>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,3"
                                            CornerRadius="6" Background="#B3000000">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                       MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                            <FontIcon Glyph="&#xF781;" FontSize="12" Foreground="#F23F43" Visibility="{x:Bind MutedVisibility}" />
                                            <FontIcon Glyph="&#xE7F6;" FontSize="12" Foreground="#F23F43" Visibility="{x:Bind DeafVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Stats for nerds -->
                    <Border x:Name="StatsPanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="16" Padding="14,10" CornerRadius="8" Background="#E6000000"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="StatsTitle" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" />
                            <TextBlock x:Name="StatsText" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="18"
                                       Foreground="#B5F5C4" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>

                    <!-- Call controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,24">
                        <Button x:Name="CallMuteButton" Click="OnToggleMute" Width="56" Height="56" CornerRadius="28" Padding="0"
                                Background="#2B2D31" BorderThickness="0">
                            <FontIcon x:Name="CallMuteIcon" Glyph="&#xE720;" FontSize="20" />
                        </Button>
                        <Button x:Name="CallDeafenButton" Click="OnToggleDeafen" Width="56" Height="56" CornerRadius="28" Padding="0"
                                Background="#2B2D31" BorderThickness="0">
                            <FontIcon x:Name="CallDeafenIcon" Glyph="&#xE7F6;" FontSize="20" />
                        </Button>
                        <Button x:Name="CallShareButton" Click="OnShareScreen" Width="56" Height="56" CornerRadius="28" Padding="0"
                                Background="#2B2D31" BorderThickness="0">
                            <FontIcon Glyph="&#xE7F4;" FontSize="20" />
                        </Button>
                        <ToggleButton x:Name="CallStatsButton" Click="OnToggleStats" Width="56" Height="56" CornerRadius="28" Padding="0"
                                      Background="#2B2D31" BorderThickness="0">
                            <FontIcon Glyph="&#xE9D9;" FontSize="20" />
                        </ToggleButton>
                        <Button x:Name="CallLeaveButton" Click="OnVoiceDisconnect" Width="72" Height="56" CornerRadius="28" Padding="0"
                                Background="#DA373C" BorderThickness="0">
                            <FontIcon Glyph="&#xE778;" FontSize="20" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ======================= Friends page (Home) ======================= -->
                <Grid x:Name="FriendsView" Grid.RowSpan="4" Visibility="Collapsed" Background="{StaticResource ChatBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE716;" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="FriendsTitleText" Text="Amis" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{StaticResource HeaderTextBrush}" Margin="0,0,8,0" />
                            <Ellipse Width="4" Height="4" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Button x:Name="TabOnline" Content="En ligne" Tag="online" Click="OnFriendsTab" Padding="10,4"
                                    CornerRadius="6" BorderThickness="0" Background="Transparent" />
                            <Button x:Name="TabAll" Content="Tous" Tag="all" Click="OnFriendsTab" Padding="10,4"
                                    CornerRadius="6" BorderThickness="0" Background="Transparent" />
                            <Button x:Name="TabPending" Content="En attente" Tag="pending" Click="OnFriendsTab" Padding="10,4"
                                    CornerRadius="6" BorderThickness="0" Background="Transparent" />
                            <Button x:Name="TabAdd" Content="Ajouter" Tag="add" Click="OnFriendsTab" Padding="10,4"
                                    CornerRadius="6" BorderThickness="0" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Search (list tabs) / add-friend form (Ajouter tab) -->
                    <StackPanel Grid.Row="1" Padding="24,16,24,8" Spacing="8">
                        <TextBox x:Name="FriendsSearch" PlaceholderText="Rechercher" TextChanged="OnFriendsSearchChanged" />
                        <StackPanel x:Name="AddFriendPanel" Visibility="Collapsed" Spacing="8">
                            <TextBlock x:Name="AddFriendTitle" Text="Ajouter" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" />
                            <TextBlock x:Name="AddFriendHintText" Text="Tu peux ajouter des amis grâce à leur nom d'utilisateur Discord." FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AddFriendBox" PlaceholderText="Tu peux ajouter des amis grâce à leur nom d'utilisateur." />
                                <Button x:Name="SendFriendRequestButton" Grid.Column="1" Content="Envoyer une demande d'ami" Click="OnSendFriendRequest"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <TextBlock x:Name="AddFriendResult" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="FriendsCount" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <ListView x:Name="FriendsList" Grid.Row="2" SelectionMode="None" Padding="16,0,16,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FriendItem">
                                <Grid Height="62" ColumnSpacing="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32">
                                        <Border CornerRadius="16" Background="{StaticResource ComposerBrush}">
                                            <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                        </Border>
                                        <Ellipse Width="12" Height="12" Margin="0,0,-2,-2" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" Fill="{x:Bind StatusBrush}"
                                                 Stroke="{StaticResource ChatBrush}" StrokeThickness="2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource HeaderTextBrush}" />
                                            <Border Visibility="{x:Bind TagVisibility}" CornerRadius="4" Padding="5,0"
                                                    Background="#2E2F35" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Tag}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource HeaderTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind Id}" Click="OnFriendMessage" Visibility="{x:Bind MessageVisibility}"
                                                Width="36" Height="36" CornerRadius="18" Padding="0" Background="{StaticResource PanelBrush}"
                                                BorderThickness="0" ToolTipService.ToolTip="Message">
                                            <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                                        </Button>
                                        <Button Tag="{x:Bind Id}" Click="OnFriendAccept" Visibility="{x:Bind AcceptVisibility}"
                                                Width="36" Height="36" CornerRadius="18" Padding="0" Background="{StaticResource PanelBrush}"
                                                BorderThickness="0" ToolTipService.ToolTip="Accepter">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#23A55A" />
                                        </Button>
                                        <Button Tag="{x:Bind Id}" Click="OnFriendRemove" Width="36" Height="36" CornerRadius="18"
                                                Padding="0" Background="{StaticResource PanelBrush}" BorderThickness="0"
                                                ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#F23F43" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Member list -->
            <Grid x:Name="MembersPane" Grid.Column="3" Grid.RowSpan="2" Width="256" Background="{StaticResource SidebarBrush}"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,0,0">
                <ListView x:Name="MemberList" SelectionMode="None" Padding="8,8,8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MemberItem">
                            <Grid>
                                <TextBlock Visibility="{x:Bind GroupVisibility}" Text="{x:Bind Name}" Margin="0,16,0,4"
                                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <Grid Visibility="{x:Bind MemberVisibility}" Opacity="{x:Bind RowOpacity}" Height="44"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32">
                                        <Border CornerRadius="16" Background="{StaticResource ComposerBrush}">
                                            <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                        </Border>
                                        <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Fill="{x:Bind StatusBrush}" Stroke="{StaticResource SidebarBrush}" StrokeThickness="2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Foreground="{x:Bind NameBrush}" />
                                        <TextBlock Text="{x:Bind Activity}" Visibility="{x:Bind ActivityVisibility}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ======================= Login ======================= -->
        <Grid x:Name="LoginRoot" Grid.Row="1" Background="{StaticResource BlurpleBrush}">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
            <Border Width="720" MinHeight="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="8" Padding="32" Background="{StaticResource ChatBrush}">
                <Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="60" /></TransitionCollection></Border.Transitions>
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="LoginWelcomeText" Text="Ha, te revoilà !" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource HeaderTextBrush}" />
                        <TextBlock x:Name="LoginSubtitleText" Text="Client natif WinUI 3 — sans Electron." HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="LoginTokenLabel" Text="TOKEN (option avancée)" Margin="0,16,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <PasswordBox x:Name="TokenBox" PlaceholderText="Colle ton token ici" />
                        <Button x:Name="TokenLoginButton" Content="Connexion" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" Click="OnTokenLogin" />
                        <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="#F23F42" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                        <Border Width="176" Height="176" CornerRadius="8" Background="White" Padding="8"
                                HorizontalAlignment="Center">
                            <Grid>
                                <ProgressRing x:Name="QrProgress" IsActive="True" Width="32" Height="32" />
                                <Image x:Name="QrImage" Stretch="Uniform" Opacity="0">
                                    <Image.OpacityTransition><ScalarTransition Duration="0:0:0.3" /></Image.OpacityTransition>
                                </Image>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="QrTitle" Text="Se connecter avec un code QR" FontSize="18" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource HeaderTextBrush}" />
                        <TextBlock x:Name="QrHint" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Scanne ce code avec l'application mobile Discord pour te connecter instantanément." />
                        <HyperlinkButton x:Name="QrRetry" Content="Générer un nouveau code" HorizontalAlignment="Center"
                                         Visibility="Collapsed" Click="OnQrRetry" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Video fullscreen layer (the playing video is moved here, then back) -->
        <Grid x:Name="FullscreenHost" Grid.RowSpan="2" Visibility="Collapsed" Background="Black" />
    </Grid>
</Window>
