<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DiscordWin3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Discord "dark" palette (2025+ refresh) -->
            <SolidColorBrush x:Key="RailBrush" Color="#0E0E10" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#0E0E10" />
            <SolidColorBrush x:Key="ChatBrush" Color="#0E0E10" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#18181B" />
            <SolidColorBrush x:Key="PanelBrush" Color="#161618" />
            <SolidColorBrush x:Key="CardBrush" Color="#18181B" />
            <SolidColorBrush x:Key="LineBrush" Color="#222226" />
            <SolidColorBrush x:Key="BlurpleBrush" Color="#5865F2" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#949BA4" />
            <SolidColorBrush x:Key="HeaderTextBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="BodyTextBrush" Color="#DBDEE1" />
            <SolidColorBrush x:Key="LinkBrush" Color="#00A8FC" />

            <!-- Flat list rows like Discord (no accent pill, soft hover) -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#19191C" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#26262A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#26262A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#222225" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#26262A" />

            <!-- Small square icon buttons of the message hover bar -->
            <Style x:Key="HoverButton" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
