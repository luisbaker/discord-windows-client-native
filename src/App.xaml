<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DiscordWin3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Discord "dark" palette (2025+ refresh) -->
            <SolidColorBrush x:Key="RailBrush" Color="#121214" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#121214" />
            <SolidColorBrush x:Key="ChatBrush" Color="#1A1A1E" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#222327" />
            <SolidColorBrush x:Key="PanelBrush" Color="#1E1F22" />
            <SolidColorBrush x:Key="CardBrush" Color="#202024" />
            <SolidColorBrush x:Key="LineBrush" Color="#2A2A2F" />
            <SolidColorBrush x:Key="BlurpleBrush" Color="#5865F2" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#949BA4" />
            <SolidColorBrush x:Key="HeaderTextBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="BodyTextBrush" Color="#DBDEE1" />
            <SolidColorBrush x:Key="LinkBrush" Color="#00A8FC" />

            <!-- Flat list rows like Discord (no accent pill, soft hover) -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1D1D21" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2C2C31" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2C2C31" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#26262B" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2C2C31" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
