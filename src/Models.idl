namespace DiscordWin3
{
    // Items are immutable (bound OneTime). Updates replace the item in its collection,
    // which avoids the cost of INotifyPropertyChanged plumbing on every row.

    runtimeclass GuildItem
    {
        String Id { get; };
        String Name { get; };
        String Initials { get; };
        Microsoft.UI.Xaml.Media.ImageSource Icon { get; };
        Microsoft.UI.Xaml.Visibility IconVisibility { get; };
        Microsoft.UI.Xaml.Visibility InitialsVisibility { get; };
        Microsoft.UI.Xaml.Visibility UnreadVisibility { get; };
        String MentionText { get; };
        Microsoft.UI.Xaml.Visibility MentionVisibility { get; };
    }

    runtimeclass ChannelItem
    {
        String Id { get; };
        String Name { get; };
        String Glyph { get; };
        Boolean IsCategory { get; };
        Boolean IsTextLike { get; };
        Boolean IsVoiceUser { get; };
        Microsoft.UI.Xaml.Media.ImageSource Avatar { get; };
        Microsoft.UI.Xaml.Visibility AvatarVisibility { get; };
        Double AvatarSize { get; };
        Microsoft.UI.Xaml.Media.Brush AvatarRing { get; };
        Microsoft.UI.Xaml.Media.Brush StatusBrush { get; };
        Microsoft.UI.Xaml.Visibility StatusVisibility { get; };
        String Subtitle { get; };
        Microsoft.UI.Xaml.Visibility SubtitleVisibility { get; };
        Microsoft.UI.Xaml.Visibility GlyphVisibility { get; };
        Microsoft.UI.Xaml.Thickness ItemMargin { get; };
        Double TextOpacity { get; };
        Microsoft.UI.Xaml.Visibility CategoryVisibility { get; };
        Microsoft.UI.Xaml.Visibility ChannelVisibility { get; };
        Microsoft.UI.Xaml.Media.Brush NameBrush { get; };
        Windows.UI.Text.FontWeight NameWeight { get; };
        String MentionText { get; };
        Microsoft.UI.Xaml.Visibility MentionVisibility { get; };
    }

    runtimeclass MessageItem
    {
        String Id { get; };
        String AuthorId { get; };
        String AuthorName { get; };
        Microsoft.UI.Xaml.Media.Brush AuthorBrush { get; };
        String Timestamp { get; };
        Int64 UnixMs { get; };
        Microsoft.UI.Xaml.Media.ImageSource Avatar { get; };
        Microsoft.UI.Xaml.Visibility HeaderVisibility { get; };
        Microsoft.UI.Xaml.Thickness RowPadding { get; };
        Microsoft.UI.Xaml.Media.Brush RowBackground { get; };
        Microsoft.UI.Xaml.Visibility ContentVisibility { get; };
        Microsoft.UI.Xaml.Visibility ReactionsVisibility { get; };
        Microsoft.UI.Xaml.Visibility OwnVisibility { get; };
        Microsoft.UI.Xaml.Visibility OthersVisibility { get; };
        Microsoft.UI.Xaml.Visibility DayVisibility { get; };
        String DayText { get; };
        String TagText { get; };
        Microsoft.UI.Xaml.Visibility TagVisibility { get; };
        String ReplyText { get; };
        Microsoft.UI.Xaml.Visibility ReplyVisibility { get; };
        Microsoft.UI.Xaml.Media.ImageSource Image { get; };
        Microsoft.UI.Xaml.Visibility ImageVisibility { get; };
        Microsoft.UI.Xaml.Visibility VideoVisibility { get; };
        Double ImageWidth { get; };
        Double ImageHeight { get; };
        String Files { get; };
        Microsoft.UI.Xaml.Visibility FilesVisibility { get; };
        Microsoft.UI.Xaml.Visibility EmbedVisibility { get; };
        Microsoft.UI.Xaml.Media.Brush EmbedBar { get; };
        String EmbedProvider { get; };
        Microsoft.UI.Xaml.Visibility EmbedProviderVisibility { get; };
        String EmbedTitle { get; };
        Microsoft.UI.Xaml.Visibility EmbedTitleVisibility { get; };
        String EmbedDescription { get; };
        Microsoft.UI.Xaml.Visibility EmbedDescriptionVisibility { get; };
    }

    runtimeclass FriendItem
    {
        String Id { get; };
        String Name { get; };
        String Tag { get; };
        Microsoft.UI.Xaml.Visibility TagVisibility { get; };
        String Subtitle { get; };
        Microsoft.UI.Xaml.Media.ImageSource Avatar { get; };
        Microsoft.UI.Xaml.Media.Brush StatusBrush { get; };
        Microsoft.UI.Xaml.Visibility MessageVisibility { get; };
        Microsoft.UI.Xaml.Visibility AcceptVisibility { get; };
        String RemoveLabel { get; };
    }

    runtimeclass ParticipantItem
    {
        String UserId { get; };
        String Name { get; };
        Microsoft.UI.Xaml.Media.ImageSource Avatar { get; };
        Microsoft.UI.Xaml.Media.Brush RingBrush { get; };
        Microsoft.UI.Xaml.Visibility MutedVisibility { get; };
        Microsoft.UI.Xaml.Visibility DeafVisibility { get; };
    }

    runtimeclass MemberItem
    {
        Boolean IsGroup { get; };
        String Name { get; };
        String Activity { get; };
        Microsoft.UI.Xaml.Media.Brush NameBrush { get; };
        Microsoft.UI.Xaml.Media.Brush StatusBrush { get; };
        Microsoft.UI.Xaml.Media.ImageSource Avatar { get; };
        Double RowOpacity { get; };
        Microsoft.UI.Xaml.Visibility GroupVisibility { get; };
        Microsoft.UI.Xaml.Visibility MemberVisibility { get; };
        Microsoft.UI.Xaml.Visibility ActivityVisibility { get; };
    }
}
